{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/catalogue",
      "destination": "/index.html"
    },
    {
      "source": "/anime/:id",
      "destination": "/index.html"
    },
    {
      "source": "/profil",
      "destination": "/index.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/index.html"
    },
    {
      "source": "/comparer",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://graphql.anilist.co https://api.mymemory.translated.net; img-src 'self' data: https://s4.anilist.co https://cdn.myanimelist.net https://img.youtube.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      256
    ],
    "qualities": [
      70
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "s4.anilist.co",
        "pathname": "^/file/anilistcdn/media/anime/cover/.*$"
      },
      {
        "protocol": "https",
        "hostname": "cdn.myanimelist.net",
        "pathname": "^/images/anime/.*$"
      }
    ]
  }
}
